<%/* The FOG 1.6 sign-in form (ProcessLogin.php mainLoginForm, lines 192-262).
     A failed sign-in shows no alert here: api/controllers/auth/login.js
     queues a "Login Failed" toast, and the layout shows it. */%>
<div class="login-box">
  <div class="login-logo">
    <a href="/"><b>FOG</b> Project</a>
  </div>
  <div class="card">
    <div class="card-body login-card-body">
      <p class="login-box-msg">Sign in to start your session</p>
      <form action="/login" method="post">
        <input type="hidden" name="_csrf" value="<%= typeof _csrf !== 'undefined' ? _csrf : '' %>">
        <div class="input-group mb-3">
          <input id="username" name="username" type="text" class="form-control" placeholder="Username" required>
          <div class="input-group-text"><span class="fas fa-user"></span></div>
        </div>
        <div class="input-group mb-3">
          <input name="password" type="password" class="form-control" placeholder="Password" required>
          <%/* The 1.6 show/hide toggle. type="button" keeps it from
               submitting the form; views/pages/partials/login.js handles it. */%>
          <button type="button" class="input-group-text fog-password-toggle" aria-label="Show password" aria-pressed="false" tabindex="-1"><span class="far fa-eye"></span></button>
        </div>
        <div class="row align-items-center">
          <div class="col-7">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="remember" name="remember-me">
              <label class="form-check-label" for="remember">Remember Me</label>
            </div>
          </div>
          <div class="col-5">
            <button type="submit" class="btn btn-primary w-100">Sign In</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
