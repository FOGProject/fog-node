<div class="app-content">
  <div class="container-fluid">
    <% // The FOG 1.6 dashboard (DashboardPage.php:186-556). %>
    <% if (pendingHosts > 0) { %>
    <% // 1.6 displayAlert($title, $hostPend, 'warning', true, true): a dismissible callout (FOGPage.php:1676-1707). %>
    <div class="callout callout-warning alert-dismissible" id="pendingCallout">
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      <h4><%= pendingHosts %> <%= pendingHosts !== 1 ? 'Pending hosts' : 'Pending host' %></h4>
      Click <a href="/hosts/pending"><b>here</b></a> to review.
    </div>
    <% } %>
    <% if (pendingAgents > 0) { %>
    <% // Pending fog-agent enrollments (DashboardPage.php:200-228), rendered only when there are some. %>
    <div class="callout callout-warning alert-dismissible" id="pendingAgentsCallout">
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      <h4><%= pendingAgents %> <%= pendingAgents !== 1 ? 'Pending agents' : 'Pending agent' %></h4>
      Click <a href="/hosts/pendingAgents"><b>here</b></a> to review.
    </div>
    <% } %>
    <% // gy-3: every card is a column of this one row, as in 1.6, so the stacked cards get a vertical gutter. %>
    <div class="row gy-3">
      <% // System Overview %>
      <div class="col-md-4">
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h4 class="card-title">System Overview</h4>
          </div>
          <div class="card-body">
            <div class="dl-horizontal">
              <dt>Web Server</dt><dd><%= webserver %></dd>
              <dt>Load Average</dt><dd><%= loadaverage %></dd>
              <dt>System Uptime</dt><dd><%= uptime %></dd>
            </div>
          </div>
        </div>
      </div>
      <% // Storage Group Activity %>
      <div class="col-md-4">
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h4 class="card-title">Storage Group Activity</h4>
          </div>
          <div class="card-body">
            <div class="chart-responsive">
              <input type="hidden" id="avail" value="<%= avail %>">
              <input type="hidden" id="staged" value="<%= staged %>">
              <input type="hidden" id="active" value="<%= active %>">
              <canvas id="activityUsage" class="chartjs-render-monitor"></canvas>
            </div>
          </div>
        </div>
      </div>
      <% // Storage Node Disk Usage %>
      <div class="col-md-4">
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h4 class="card-title">Storage Node Disk Usage</h4>
          </div>
          <div class="card-body">
            <a href="/hwinfo" id="hwinfolink">
              <div class="chart-responsive">
                <input type="hidden" id="free" value="<%= free %>">
                <input type="hidden" id="used" value="<%= used %>">
                <canvas id="diskUsage" class="chartjs-render-monitor"></canvas>
              </div>
            </a>
          </div>
        </div>
      </div>
      <% // Imaging history %>
      <div class="col-12">
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h4 class="card-title">Imaging Over the last</h4>
            <div class="row">
              <div class="col-md-3">
                <a href="#" id="graph-day-filters-30" class="type-days graph-days active" rel="30">30 Days</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-day-filters-60" class="type-days graph-days" rel="60">60 Days</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-day-filters-90" class="type-days graph-days" rel="90">90 Days</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-day-filters-183" class="type-days graph-days" rel="183">6 Months</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-day-filters-365" class="type-days graph-days" rel="365">1 Year</a>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="chart-responsive">
              <canvas id="taskHistory" class="chartjs-render-monitor"></canvas>
            </div>
          </div>
        </div>
      </div>
      <% // Bandwidth %>
      <div class="col-12">
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h4 class="card-title">Bandwidth</h4>
            <div class="card-tools float-end">
              Real Time
              <div class="btn-group" id="realtime">
                <button type="button" id="btn-on" class="btn btn-secondary btn-sm active" data-toggle="on">On</button>
                <button type="button" id="btn-off" class="btn btn-secondary btn-sm" data-toggle="off">Off</button>
              </div>
            </div>
            <div class="row">
              <div class="col-md-2">
                <div id="graph-bandwidth-title">Bandwidth - <span>Transmit</span></div>
              </div>
              <div class="offset-md-4 col-md-6">
                <div class="category" id="graph-bandwidth-time-title">Time - <span>2 Minutes</span></div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-2">
                <a href="#" id="graph-bandwidth-filters-transmit" class="type-filters graph-filters active">Transmit</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-bandwidth-filters-receive" class="type-filters graph-filters">Receive</a>
              </div>
              <div class="offset-md-4 col-md-6">
                <a href="#" id="graph-bandwidth-time-filters-2min" class="time-filters graph-filters active" rel="120">2 Minutes</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-bandwidth-time-filters-5min" class="time-filters graph-filters" rel="300">5 Minutes</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-bandwidth-time-filters-10min" class="time-filters graph-filters" rel="600">10 Minutes</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-bandwidth-time-filters-30min" class="time-filters graph-filters" rel="1800">30 Minutes</a>
                &nbsp;&nbsp;
                <a href="#" id="graph-bandwidth-time-filters-1hr" class="time-filters graph-filters" rel="3600">1 Hour</a>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="chart-responsive">
              <canvas id="bandwidth" class="chartjs-render-monitor"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
