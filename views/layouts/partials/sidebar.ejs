<!-- Sidebar Menu -->
<% if (req.user) { %>
<%/* The FOG 1.6 universal search: one select2 box (assets/fog/fog.search.js
     builds it). No submit button, as in 1.6: each result group ends with a
     "See all results" entry that opens that type's filtered list page.
     data-no-select2 keeps assets/fog/fog.select2.js from binding it again. */%>
<div class="p-2" id="globalSearchWrap">
  <form action="/search" method="get" role="search">
    <select id="universal-search-select" data-placeholder="Search..." aria-label="Search" data-no-select2></select>
  </form>
</div>
<%/* The FOG 1.6 menu (management/other/index.php:429-451). `menu` comes from
     api/helpers/build-menu.js, which decides the order, the links and the
     active state. A node with pluginOption renders under PLUGIN OPTIONS. */%>
<% var mainNodes = menu.filter(function (n) { return !n.pluginOption; }); %>
<% var pluginNodes = menu.filter(function (n) { return n.pluginOption; }); %>
<nav class="mt-2">
  <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" aria-label="Main navigation" data-accordion="true">
    <li class="nav-header">MAIN NAVIGATION</li>
    <% mainNodes.forEach(function (node) { %>
    <%- partial('./sidebar-node.ejs', {node: node}) %>
    <% }) %>
    <% if (pluginNodes.length) { %>
    <li class="nav-header">
      PLUGIN OPTIONS
      <a href="#" class="plugin-options-alternate float-end"><i class="fas fa-minus"></i></a>
    </li>
    <% } %>
  </ul>
  <% if (pluginNodes.length) { %>
  <ul class="nav sidebar-menu flex-column plugin-options" data-lte-toggle="treeview" data-accordion="true">
    <% pluginNodes.forEach(function (node) { %>
    <%- partial('./sidebar-node.ejs', {node: node}) %>
    <% }) %>
  </ul>
  <% } %>
  <ul class="nav sidebar-menu flex-column">
    <li class="nav-header">RESOURCES</li>
    <li class="nav-item">
      <a href="https://sourceforge.net/donate/index.php?group_id=201099" class="nav-link" target="_blank">
        <i class="nav-icon fas fa-money-bill-1"></i>
        <p>Donate</p>
      </a>
    </li>
    <li class="nav-item">
      <a href="https://news.fogproject.org" class="nav-link" target="_blank">
        <i class="nav-icon fas fa-bullhorn"></i>
        <p>News</p>
      </a>
    </li>
    <li class="nav-item">
      <a href="https://forums.fogproject.org" class="nav-link" target="_blank">
        <i class="nav-icon fas fa-users"></i>
        <p>Forums</p>
      </a>
    </li>
    <li class="nav-item">
      <a href="https://docs.fogproject.org" class="nav-link" target="_blank">
        <i class="nav-icon fas fa-book"></i>
        <p>Documentation</p>
      </a>
    </li>
  </ul>
</nav>
<% } %>
